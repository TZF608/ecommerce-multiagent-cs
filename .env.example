# ================= LLM 配置 =================
# 本项目使用 OpenAI 兼容接口，可指向任意厂商。
# 复制本文件为 .env 后，任选一种厂商填好三个变量即可。

# ① DeepSeek（国内常用）
LLM_API_KEY=sk-xxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ② 月之暗面 Kimi
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# ③ 阿里通义千问（DashScope 兼容模式）
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# ④ 智谱 GLM
# LLM_API_KEY=xxx.xxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4-flash

# ⑤ OpenAI 官方（留空 base_url）
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=
# LLM_MODEL=gpt-4o-mini

# ⑥ 本地 Ollama（无需 key）
# LLM_API_KEY=EMPTY
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# ================= Embedding 配置 =================
# huggingface：本地小模型（默认，中文效果好，首次运行需联网下载一次模型）
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内下载模型慢时，先执行：set HF_ENDPOINT=https://hf-mirror.com
# 或改用 API 嵌入（注意：DeepSeek / Kimi 不支持嵌入接口）：
# EMBEDDING_PROVIDER=openai
# EMBEDDING_OPENAI_MODEL=text-embedding-3-small

# ================= 检索参数 =================
# 召回条数
TOP_K=4
# 是否启用 BM25 + 向量 混合检索（RRF 融合），0 则只用向量
USE_HYBRID=1
# 是否启用 CrossEncoder 重排（需额外下载 bge-reranker 模型），0 关闭
RERANK=0
